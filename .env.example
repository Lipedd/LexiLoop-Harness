# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
LEXILOOP_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
LEXILOOP_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
LEXILOOP_DEEPSEEK_API_KEY=
LEXILOOP_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
LEXILOOP_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
LEXILOOP_OPENAI_API_BASE=https://www.right.codes/codex/v1
LEXILOOP_OPENAI_API_KEY=
LEXILOOP_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse LEXILOOP_RIGHT_CODES_API_KEY when your gateway shares one key.
LEXILOOP_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
LEXILOOP_ANTHROPIC_API_KEY=
LEXILOOP_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
LEXILOOP_SECRET_ENV_NAMES=

# Optional. Set to 0 to disable the interactive technical-English learning bar.
LEXILOOP_LEARNING=1
